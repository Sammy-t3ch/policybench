# Run outputs: ignore everything except committed test fixtures
traces/*
!traces/fixtures/
!traces/fixtures/**

# Generated reports: ignore everything except committed fixtures and samples
reports/*
!reports/fixtures/
!reports/fixtures/**
!reports/samples/
!reports/samples/**

# Derived SQLite indexes (always rebuildable from canonical JSONL traces)
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Python bytecode, build artifacts, and packaging metadata
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Test, lint, type-check, and property-test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local secrets and credentials (never commit)
.env
.env.*
*.pem
*.key

# Editor and OS files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

{
  "schema_version": "1.0",
  "id": "pay.max_refund",
  "description": "Refunds above 500 require human approval",
  "applies_to": [
    "payments.refund"
  ],
  "effect": "require_escalation",
  "priority": 50,
  "when": {
    "op": "gt",
    "left": {
      "arg": "amount"
    },
    "right": {
